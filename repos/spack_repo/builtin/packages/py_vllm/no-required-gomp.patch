--- a/cmake/cpu_extension.cmake
+++ b/cmake/cpu_extension.cmake
@@ -53,7 +53,9 @@
         # Use the same libgomp as PyTorch at runtime
         set(ENV{LD_LIBRARY_PATH} "${VLLM_TORCH_GOMP_SHIM_DIR}:$ENV{LD_LIBRARY_PATH}")
     else()
-        # Fall back to system / toolchain libgomp
-        find_library(OPEN_MP NAMES gomp REQUIRED)
+        # Fall back to system / toolchain libgomp. Do not REQUIRE: Spack-built
+        # torch has no vendored libgomp, OPEN_MP is unused after find_library,
+        # and -fopenmp already provides the OpenMP compile/link flags.
+        find_library(OPEN_MP NAMES gomp)
     endif()
 endif()
